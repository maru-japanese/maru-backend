# Runtime: Node.js 22 or newer. Copy this file to .env; never commit credentials.
HOST=127.0.0.1
PORT=5173
# Origem usada pelo navegador. Em desenvolvimento integrado, o frontend usa 4173.
MARU_PUBLIC_ORIGIN=http://127.0.0.1:4173
# Optional. The default is data/progress, relative to the repository.
# MARU_DATA_DIR=/absolute/path/to/persistent-volume

# Somente para npm run migrate:sqlite -- --apply; nunca use no frontend.
# SUPABASE_URL=https://qxtgaalmyzyldmcpwooo.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# OAuth client of type "Web application"; login stays unavailable until configured.
# Local redirect: http://127.0.0.1:4173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Existing optional TTS Quest key; audio is streamed, never exported to disk.
TTS_QUEST_API_KEY=
